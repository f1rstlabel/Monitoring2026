# ==============================================================================
# SANOC — Sanditel Network Operations Center Root .gitignore
# ==============================================================================

# ─── IDE, Agents & Workspace Settings ──────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
.claude/
.agents/
.odo/
skills-lock.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ─── System / OS Files ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Environment Variables & Sensitive Credentials ─────────────────────────
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key
*.crt
*.pfx
*.keystore
*.jks
credentials.json
secrets.json
*.secret
*.config.local.json

# ─── Logs, Diagnostics & Run Artifacts ────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
debug.log

# ─── Local Binaries, Builds & Dependencies ──────────────────────────────────
bin/
dist/
tmp/
backend/tmp/
node_modules/
.vite/
frontend/.vite/
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep
backend/wa-sidecar/auth_sessions/
backend/wa-sidecar/auth_info_baileys/
auth_sessions/

# ─── Compiled Go & Node Artifacts ─────────────────────────────────────────────
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.cover
*.apk
*.aab
test_*.go

# ─── Database Dumps & Local Storage ──────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.bak

# ─── Temporary Scripts & Scratch Files ────────────────────────────────────────
dev-run.sh
scratch/



docs/

PRD.md
commit.md
pengerjaan.md

# ─── TestSprite ─────────────────────────────────────────────────────────────
TESTSPRITE_TESTING.md
testsprite_tests/
