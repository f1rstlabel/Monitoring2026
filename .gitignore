# ==============================================================================
# SANOC — Smart Agent & Network Operations Center Root .gitignore
# ==============================================================================

# ─── IDE, Editors & Workspace Settings ───────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ─── System / OS Files ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Environment Variables & Sensitive Credentials ─────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*.keystore
*.jks
credentials.json
secrets.json
*.secret
*.config.local.json

# ─── Logs, Diagnostics & Run Artifacts ────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
debug.log

# ─── Local Binaries, Builds & Dependencies ──────────────────────────────────
bin/
dist/
node_modules/
.vite/
frontend/.vite/
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep
backend/wa-sidecar/auth_sessions/
auth_sessions/

# ─── Compiled Go & Node Artifacts ─────────────────────────────────────────────
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.cover
*.apk
*.aab

# ─── Database Dumps & Local Storage ──────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.bak

# ─── Temporary Scripts & Scratch Files ───────────────────────────────────────
dev-run.sh
PROJECT_STRUCTURE.md
scratch/
.agents/
docs/
*.env.example
.env.example
