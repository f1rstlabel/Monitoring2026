# ==============================================================================
# GovMonitor IT — Root .gitignore
# ==============================================================================

# ─── IDE, Editors & Workspace Settings ───────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ─── System / OS Files ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Logs and Run Artifacts ──────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Local Binaries & Builds ─────────────────────────────────────────────────
bin/
dist/
node_modules/
docs/

# ─── Root Environment Variables ──────────────────────────────────────────────
.env
.env.local
*.env
!.env.example
