# ─── SANOC — Backend .env Example ───────────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env with secrets.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080

# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=sanoc
DB_SSLMODE=disable

# ─── Cache ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Security ────────────────────────────────────────────────────────────────
JWT_SECRET=changeme-use-long-random-string
JWT_EXPIRY=24h

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ─── WhatsApp Baileys Sidecar ────────────────────────────────────────────────
WHATSAPP_GATEWAY_URL=http://localhost:3001
WA_SIDECAR_TOKEN=changeme
WHATSAPP_TARGET_NUMBER=6281290008888

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
