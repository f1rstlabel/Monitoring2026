# ==============================================================================
# GovMonitor IT — Backend .gitignore (Go API / Poller)
# ==============================================================================

# ─── Go Compiled Binaries ─────────────────────────────────────────────────────
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# ─── Dependencies ────────────────────────────────────────────────────────────
# Uncomment if using vendor folder and don't want to commit it:
# vendor/

# ─── Local Configuration & Environment ────────────────────────────────────────
.env
.env.local
.env.production
.env.development
.env.example
env.example

# ─── Logs & Database Files ────────────────────────────────────────────────────
*.log
logs/
*.db
*.sqlite
*.sqlite3

# ─── IDE & Tooling ───────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
