# ─── GovMonitor IT — WhatsApp Baileys Sidecar — Example Config ───────────────
# Copy this file to .env and fill in real values. Never commit .env with secrets.

PORT=3001

# Path where Baileys multi-file auth state is stored (persists between restarts)
WHATSAPP_SESSION_PATH=./auth_sessions/whatsapp

# Internal token shared with Go backend — MUST match WA_SIDECAR_TOKEN in backend .env
# Leave empty to disable auth (not recommended for production)
INTERNAL_TOKEN=changeme
